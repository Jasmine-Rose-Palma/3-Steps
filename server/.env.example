# Copy this file to a new file named .env and fill in YOUR values.
# Never commit .env - it holds your password. (.gitignore already blocks it.)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/three_steps
PORT=3000

# Your Supabase project URL, exactly as shown in the dashboard, with no path on the end.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Websites allowed to call this API, separated by commas. No trailing slash, no path.
# Locally the Vite dev server forwards /api, so this can stay empty. When deployed, put your GitHub Pages address here, for example https://your-username.github.io
CORS_ORIGINS=
