# Copy this file to .env (never commit .env) and fill in your own values.
# Both values are in your Supabase project under Project Settings > API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Leave this unset while developing: Vite forwards /api to http://localhost:3000.
# Only set it for a deployed build, to the full address of your API.
# VITE_API_URL=
